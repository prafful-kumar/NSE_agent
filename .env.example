# ── Application ────────────────────────────────────────────────────────────────
APP_ENV=development           # development | staging | production
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://investing:investing@localhost:5432/investing_agent
# Alembic uses the same URL for migrations (sync dialect, psycopg3)

# ── Zerodha Kite MCP ───────────────────────────────────────────────────────────
# Official Kite MCP: https://zerodha.com/products/mcp/
ZERODHA_MCP_URL=https://mcp.kite.trade/mcp
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=       # Refresh daily; never commit

# ── LLM (Claude) ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=           # https://console.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Broker Execution Safety ────────────────────────────────────────────────────
# NEVER set to true until human-approval workflow is fully tested
BROKER_EXECUTION_ENABLED=false

# ── LangSmith (optional tracing) ───────────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=investing-agent

# ── Data freshness (seconds) ───────────────────────────────────────────────────
PRICE_STALENESS_SECONDS=300        # 5 min
PORTFOLIO_STALENESS_SECONDS=3600   # 1 hr
FUNDAMENTALS_STALENESS_SECONDS=86400  # 24 hr

# ── Default user ───────────────────────────────────────────────────────────────
DEFAULT_USER_ID=default
